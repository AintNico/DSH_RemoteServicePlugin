<Window
    x:Class="DshRemote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DshRemote.Models"
    Title="DSH 远程">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="WorkspaceEntryTemplate" x:DataType="models:WorkspaceEntryDto">
                <StackPanel Padding="0,6" Spacing="2">
                    <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:MessageItem">
                <Grid Padding="0,4">
                    <Border
                        HorizontalAlignment="Right"
                        MaxWidth="640"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="White" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:MessageItem">
                <Grid Padding="0,4">
                    <Border
                        HorizontalAlignment="Left"
                        MaxWidth="640"
                        Padding="12,8"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ToolMessageTemplate" x:DataType="models:MessageItem">
                <Grid Padding="0,2">
                    <TextBlock
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <models:MessageTemplateSelector
                x:Key="MessageTemplateSelector"
                User="{StaticResource UserMessageTemplate}"
                Assistant="{StaticResource AssistantMessageTemplate}"
                Tool="{StaticResource ToolMessageTemplate}" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 会话侧边栏 -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="会话" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ProgressRing x:Name="Busy" Grid.Column="1" IsActive="False" Width="16" Height="16" Margin="8,0" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="OnRefreshClick" />
                </Grid>

                <ListView
                    x:Name="SessionList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="OnSessionSelectionChanged">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="16,14,16,4" Spacing="1">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding Subtitle}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionItem">
                            <Grid Padding="12,8,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Dot}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Padding="16,12" Spacing="6">
                    <TextBlock
                        x:Name="ServerLabel"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="配对码" Click="OnPairingInfoClick" />
                        <Button Content="远程访问" Click="OnRemoteClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 会话详情 -->
        <Grid Grid.Column="1" Padding="28,20,28,20">
            <StackPanel
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="6">
                <TextBlock Text="选择一个会话" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="左侧列表会随电脑端的变化刷新"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="DetailPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DetailPath"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
                        <TextBlock
                            Text="允许审批"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch
                            x:Name="ApprovalToggle"
                            MinWidth="0"
                            OnContent="开"
                            OffContent="关"
                            Toggled="OnApprovalToggled" />
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="MessageList"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                    Padding="0,4,10,4"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <StackPanel
                    x:Name="ApprovalPanel"
                    Grid.Row="2"
                    Spacing="8"
                    Visibility="Collapsed" />

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        PlaceholderText="输入消息，Enter 发送"
                        MaxHeight="120"
                        TextWrapping="Wrap"
                        KeyDown="OnComposerKeyDown" />
                    <Button
                        x:Name="AttachButton"
                        Grid.Column="1"
                        Content="附文件"
                        Click="OnAttachClick" />
                    <Button
                        x:Name="FilesButton"
                        Grid.Column="2"
                        Content="文件"
                        Click="OnFilesClick" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="3"
                        Content="发送"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSendClick" />
                    <Button x:Name="StopButton" Grid.Column="4" Content="停止" Click="OnStopClick" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 未连接遮罩：本机插件没起来时才会出现 -->
        <Grid
            x:Name="OfflineOverlay"
            Grid.ColumnSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10">
                <TextBlock Text="未连接到 DSH 插件" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="桌面端和插件跑在同一台电脑上，正常情况下无需配对。看到这条说明插件服务没起来，或端口不是 7317。"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="OfflineError"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RetryButton"
                    Content="重试连接"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnRetryClick"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
