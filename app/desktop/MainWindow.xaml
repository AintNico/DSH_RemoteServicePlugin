<Window
    x:Class="DshRemote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DshRemote.Models"
    Title="DSH 远程">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="WorkspaceEntryTemplate" x:DataType="models:WorkspaceEntryDto">
                <StackPanel Padding="0,6" Spacing="2">
                    <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 会话侧边栏 -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="会话" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ProgressRing x:Name="Busy" Grid.Column="1" IsActive="False" Width="16" Height="16" Margin="8,0" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="OnRefreshClick" />
                </Grid>

                <ListView
                    x:Name="SessionList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="OnSessionSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionItem">
                            <Grid Padding="0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Dot}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Padding="16,12" Spacing="6">
                    <TextBlock
                        x:Name="ServerLabel"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="重新配对" Click="OnRepairClick" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 会话详情 -->
        <Grid Grid.Column="1" Padding="28,20,28,20">
            <StackPanel
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="6">
                <TextBlock Text="选择一个会话" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="左侧列表会随电脑端的变化刷新"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="DetailPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DetailPath"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
                        <TextBlock
                            Text="允许审批"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch
                            x:Name="ApprovalToggle"
                            MinWidth="0"
                            OnContent="开"
                            OffContent="关"
                            Toggled="OnApprovalToggled" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    x:Name="MessageScroll"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <StackPanel x:Name="MessagePanel" Spacing="10" Padding="0,4,10,4" />
                </ScrollViewer>

                <StackPanel
                    x:Name="ApprovalPanel"
                    Grid.Row="2"
                    Spacing="8"
                    Visibility="Collapsed" />

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        PlaceholderText="输入消息，Enter 发送"
                        MaxHeight="120"
                        TextWrapping="Wrap"
                        KeyDown="OnComposerKeyDown" />
                    <Button
                        x:Name="AttachButton"
                        Grid.Column="1"
                        Content="附文件"
                        Click="OnAttachClick" />
                    <Button
                        x:Name="FilesButton"
                        Grid.Column="2"
                        Content="文件"
                        Click="OnFilesClick" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="3"
                        Content="发送"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSendClick" />
                    <Button x:Name="StopButton" Grid.Column="4" Content="停止" Click="OnStopClick" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 配对遮罩 -->
        <Grid
            x:Name="PairOverlay"
            Grid.ColumnSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10">
                <TextBlock Text="连接到 DSH 插件" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="在 DSH 的插件服务运行后，用配对码绑定这台电脑。"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBox x:Name="ServerBox" Header="服务地址" Text="http://127.0.0.1:7317" />
                <TextBox x:Name="CodeBox" Header="配对码" MaxLength="6" PlaceholderText="6 位数字" />
                <TextBox x:Name="DeviceBox" Header="设备名称" />
                <Button
                    x:Name="PairButton"
                    Content="配对"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnPairClick"
                    HorizontalAlignment="Stretch" />
                <TextBlock
                    x:Name="PairError"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
